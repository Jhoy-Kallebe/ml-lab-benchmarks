# ==========================================
# MLOps - Configuração do Benchmark
# ==========================================

# Modelo
MODEL="qwen2.5:3b"
TOKENIZER="Qwen/Qwen2.5-3B-Instruct"

# Servidor de inferência
API_URL="http://127.0.0.1:11435"

# Imagem Docker
DOCKER_IMAGE="guidellm-ollama:latest"

# Carga de trabalho
INPUT_TOKENS=128
OUTPUT_TOKENS=128
REQUESTS=10
CONCURRENCIES="1 2"

# Aquecimento
WARMUP_TOKENS=32
